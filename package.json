{
  "name": "aygo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node scripts/server.mjs dev",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node scripts/server.mjs test",
    "test:web": "npm run test --workspace web",
    "typecheck": "npm run typecheck --workspace web",
    "test:e2e": "npm run test:e2e --workspace web"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  }
}
